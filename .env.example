VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PROXY_URL=
# Telegram user ids allowed to open the Debug screen, comma-separated (e.g. 123456789,987654321).
# Empty or unset = nobody. Local dev outside Telegram (npm run dev) is always allowed.
# It hides the screen; it is not a security boundary: data is protected by Supabase RLS.
VITE_DEBUG_TG_IDS=
# The bot's username (not a URL), for the link in Settings > About: https://t.me/<username>.
# Empty, unset or REPLACE_ME = no link is shown.
VITE_BOT_USERNAME=
